{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node .claude/ferramentas/buscar-log.js:*)",
      "Bash(node .claude/ferramentas/executar-suite.js:*)",
      "Bash(node .claude/ferramentas/iniciar-tarefa.js:*)",
      "Bash(node --test \".claude/testes-harness/*.test.js\")",
      "Bash(git diff:*)",
      "Bash(git status:*)"
    ],
    "deny": [
      "Read(./harness/logs/brutos/**)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "requisitos|manutencao|testes|codificacao|projeto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ciclo.js\""
          }
        ]
      }
    ]
  }
}

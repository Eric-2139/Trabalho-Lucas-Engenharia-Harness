# Copie para infra/producao/.env (ignorado pelo git) e preencha. Nada de segredo no repositório.
# Endereços públicos. Os dois precisam apontar (DNS A/AAAA) para o servidor; o Caddy emite o HTTPS.
SITE_PLAYER=mathscape.exemplo.com
SITE_EDITOR=editor.mathscape.exemplo.com
# Senha do PostgreSQL: gere com  openssl rand -hex 24
SENHA_BANCO=
# Backup diário (opcional)
DIRETORIO_BACKUP=./backups
DIAS_BACKUP=7
